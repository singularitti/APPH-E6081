#!/usr/bin/env wolframscript
(* ::Package:: *)

v2to9={-0.04,-0.04,-0.04,-0.04,-0.02,-0.02,-0.02,-0.02};
h2to9={(kx+1)^2+ky^2,(kx-1)^2+ky^2,kx^2+(ky+1)^2,kx^2+(ky-1)^2,(kx+1)^2+(ky-1)^2,(kx-1)^2+(ky-1)^2,(kx+1)^2+(ky-1)^2,(kx-1)^2+(ky+1)^2};
e2=Table[(v2to9[[i]])^2/((kx^2+ky^2)-h2to9[[i]]),{i,1,8}]//Total//Simplify
Plot[-0.0032+0.0004/(-1.+kx)+kx^2-0.0004/(1.+kx)+0.0008/(-0.5+1. kx)-0.0008/(0.5+1. kx),{kx,0,1/2}]


(kx^2+0+e2)/.ky->0
